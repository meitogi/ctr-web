# Repository-wide generated and private inputs.
#
# Machine-specific files belong in `.git/info/exclude`.
/build/
/build-*/
/cmake-build-*/
/dist/
/debug/
# The VPS relay's key, for web/dev.sh's ready link (never committed).
/web/.relay-key
# web/pages/assemble.sh's output — rebuilt by the Pages workflow every run.
/site/

# User-supplied retail game files. Commit descriptors and hashes, never binaries.
/assets/

# Local matching experiments and caches.
/.cache/

# Runtime state.
/memcards/
*.log

# Compiler outputs.
*.exe
*.o
*.gch
*.a
*.obj
*.pdb
*.ilk
*.d
*.depend
*.map
compile_commands.json

# Language and editor state.
.venv/
__pycache__/
*.py[cod]
.vs/
.idea/
*.swp
*~
# The tests' snapshots (web/test/player/serve.py, /__states) : the game's memory, never committed.
/web/test/player/.states/
# The tests' memory cards and recorded races (session 45b) : the game's icon frames, its memory.
/web/test/player/.saves/
/web/test/player/.replays/
